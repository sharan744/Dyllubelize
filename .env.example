# Copy this file to ".env" and adjust the values for the machine it runs on.

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL database ---
DB_NAME=sopd_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Localisation ---
TIME_ZONE=America/Belize
CURRENCY_SYMBOL=$
CURRENCY_CODE=BZD

# --- Email notifications (Gmail SMTP) ---
# EMAIL_HOST_PASSWORD must be a Gmail *App Password* (16 chars), NOT your normal
# Gmail login password. Create one at: Google Account > Security > 2-Step
# Verification > App passwords. Paste it below without spaces.
NOTIFY_ENABLED=True
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=sharanic44@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=UDL Belize <sharanic44@gmail.com>
